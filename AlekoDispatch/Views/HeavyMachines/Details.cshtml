
@using AlekoDispatch.ViewModels.HeavyMachines

@model HeavyMachineDetailsViewModel

@{
    ViewData["Title"] = $"Machine Details - {Model.Model}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>@Model.Model</h1>

        @if (Model.IsOperational)
        {
            <span class="badge bg-success">Operational</span>
        }
        else
        {
            <span class="badge bg-danger">Under Maintenance</span>
        }

        <p class="text-muted mt-2 mb-0">
            Inventory Number: @Model.InventoryNumber |
            Type: @Model.Type
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Fleet
        </a>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Machine Information</h5>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Machine Type</dt>
                    <dd class="col-sm-6">@Model.Type</dd>

                    <dt class="col-sm-6">Inventory Number</dt>
                    <dd class="col-sm-6">@Model.InventoryNumber</dd>

                    <dt class="col-sm-6">Engine Hours</dt>
                    <dd class="col-sm-6">
                        @Model.CurrentEngineHours.ToString("N1") hrs
                    </dd>

                    <dt class="col-sm-6">Current Work Site</dt>
                    <dd class="col-sm-6">
                        @if (Model.CurrentWorkSiteId.HasValue)
                        {
                            <a asp-controller="WorkSites"
                               asp-action="Details"
                               asp-route-id="@Model.CurrentWorkSiteId">
                                @Model.CurrentWorkSiteName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-6">Total Work Logs</dt>
                    <dd class="col-sm-6">@Model.TotalLogsCount</dd>

                    <dt class="col-sm-6">Total Hours Worked</dt>
                    <dd class="col-sm-6">
                        @Model.TotalHoursWorked.ToString("N1") hrs
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Work Logs</h5>
                <span class="text-muted small">Last 5 records</span>
            </div>

            <div class="card-body p-0">
                @if (!Model.RecentLogs.Any())
                {
                    <p class="text-muted text-center my-4">
                        No work logs have been recorded for this machine yet.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Operator</th>
                                    <th>Work Site</th>
                                    <th class="text-end">Hours Worked</th>
                                    <th class="text-end">Fuel Used</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var log in Model.RecentLogs)
                                {
                                    <tr>
                                        <td>@log.Date</td>
                                        <td>@log.OperatorName</td>
                                        <td>@log.SiteName</td>

                                        <td class="text-end">
                                            @log.HoursWorked.ToString("N1") hrs
                                        </td>

                                        <td class="text-end">
                                            @(log.FuelConsumedLiters.HasValue
                                                ? $"{log.FuelConsumedLiters.Value:N1} L"
                                                : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
