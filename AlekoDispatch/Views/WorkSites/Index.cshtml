@using AlekoDispatch.ViewModels.WorkSites
@model IEnumerable<WorkSiteIndexViewModel>

@{
    ViewData["Title"] = "Work Sites";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Work Sites</h1>

    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="Create" class="btn btn-primary">New Work Site</a>
    }
</div>

@if (!Model.Any())
{
    <p>No work sites have been added yet.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Site Name</th>
                <th>Location</th>
                <th>Status</th>
                <th>Start Date</th>
                <th>Target Completion</th>
                <th>Active Machinery</th>
                <th>Work Logs</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var site in Model)
            {
                var statusClass = "bg-warning text-dark";

                if (site.Status.ToString() == "Active")
                {
                    statusClass = "bg-success";
                }
                else if (site.Status.ToString() == "Completed")
                {
                    statusClass = "bg-secondary";
                }

                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@site.Id">
                            @site.Name
                        </a>
                    </td>
                    <td>@site.Location</td>
                    <td>
                        <span class="badge @statusClass">@site.Status</span>
                    </td>
                    <td>@site.StartDate</td>
                    <td>@(site.TargetCompletionDate ?? "—")</td>
                    <td>@site.ActiveMachinesCount</td>
                    <td>@site.TotalLogsCount</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@site.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-action="Edit" asp-route-id="@site.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@site.Id">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
                @if (User.IsInRole("Administrator"))
                {
                    <div class="modal fade" id="deleteModal-@site.Id"
                         tabindex="-1"
                         aria-labelledby="deleteModalLabel-@site.Id"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content text-start">

                                <div class="modal-header">
                                    <h5 class="modal-title fs-5"
                                        id="deleteModalLabel-@site.Id">
                                        Confirm Site Deletion
                                    </h5>

                                    <button type="button" class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    Are you sure you want to delete work site
                                    <strong class="text-danger">@site.Name</strong>?

                                    <p class="small text-muted mt-2 mb-0">
                                        This action cannot be undone.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                    <form asp-action="Delete"
                                          asp-route-id="@site.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-danger">
                                            Yes, Delete
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
        </tbody>
    </table>
}