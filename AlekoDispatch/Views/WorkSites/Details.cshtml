@using AlekoDispatch.ViewModels.WorkSites
@model WorkSiteDetailsViewModel

@{
    ViewData["Title"] = "Site Details";

    var statusClass = "bg-warning text-dark";

    if (Model.Status.ToString() == "Active")
    {
        statusClass = "bg-success";
    }
    else if (Model.Status.ToString() == "Completed")
    {
        statusClass = "bg-secondary";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>
            @Model.Name
            <span class="badge @statusClass">@Model.Status</span>
        </h1>
        <p class="text-muted">@Model.Location</p>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                Edit Site
            </a>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                Site Overview
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Start Date</dt>
                    <dd class="col-sm-7">@Model.StartDate</dd>

                    <dt class="col-sm-5">Target End</dt>
                    <dd class="col-sm-7">
                        @(Model.TargetCompletionDate ?? "Indefinite")
                    </dd>

                    <dt class="col-sm-5">Allocated Units</dt>
                    <dd class="col-sm-7">@Model.AssignedMachines.Count</dd>

                    <dt class="col-sm-5">Description</dt>
                    <dd class="col-sm-7">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description provided."
                            : Model.Description)
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Allocated Machinery</span>
                <span>@Model.AssignedMachines.Count total</span>
            </div>

            @if (!Model.AssignedMachines.Any())
            {
                <div class="card-body">
                    <p class="text-muted mb-0">
                        No machinery assigned to this site.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Model</th>
                                <th>Inventory Number</th>
                                <th>Type</th>
                                <th>Engine Hours</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var machine in Model.AssignedMachines)
                            {
                                <tr>
                                    <td>@machine.Model</td>
                                    <td>@machine.InventoryNumber</td>
                                    <td>@machine.Type</td>
                                    <td>@machine.CurrentEngineHours.ToString("N1") hrs</td>
                                    <td>
                                        @if (machine.IsOperational)
                                        {
                                            <span class="badge bg-success">Ready</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Maintenance</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <span>Recent Daily Work Logs</span>
        <span class="text-muted">Last 5 submissions</span>
    </div>

    @if (!Model.RecentLogs.Any())
    {
        <div class="card-body">
            <p class="text-muted mb-0">
                No work logs recorded for this site yet.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Operator</th>
                        <th>Machine</th>
                        <th>Hours Worked</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.RecentLogs)
                    {
                        <tr>
                            <td>@log.Date</td>
                            <td>@log.WorkerName</td>
                            <td>@log.MachineModel</td>
                            <td>@log.HoursWorked.ToString("N1") hrs</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(log.Summary)
                                    ? "—"
                                    : log.Summary)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>