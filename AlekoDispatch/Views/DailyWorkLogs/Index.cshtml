
@using AlekoDispatch.ViewModels.DailyWorkLogs

@model DailyWorkLogQueryViewModel

@{
    ViewData["Title"] = "Daily Work Logs";

    bool hasActiveFilters =
        Model.WorkSiteId.HasValue ||
        Model.HeavyMachineId.HasValue ||
        !string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Daily Work Logs</h1>
        <p class="text-muted mb-0">
            Records of machine usage, fuel consumption and daily work.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Log Daily Shift
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label asp-for="WorkSiteId" class="form-label">
                        Work Site
                    </label>

                    <select asp-for="WorkSiteId"
                            asp-items="Model.WorkSites"
                            class="form-select">
                        <option value="">All Work Sites</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="HeavyMachineId" class="form-label">
                        Machine
                    </label>

                    <select asp-for="HeavyMachineId"
                            asp-items="Model.Machines"
                            class="form-select">
                        <option value="">All Machines</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SearchTerm" class="form-label">
                        Search Operator / Notes
                    </label>

                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Operator name or shift notes..." />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Filter
                    </button>

                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Logs.Any())
{
    @if (hasActiveFilters)
    {
        <p class="text-muted">
            No work logs match your filters.
            <a asp-action="Index">Reset filters</a> to see all logs.
        </p>
    }
    else
    {
        <p class="text-muted">
            No work logs have been recorded yet.
        </p>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Work Site</th>
                    <th>Machine</th>
                    <th>Operator</th>
                    <th class="text-end">Hours Worked</th>
                    <th class="text-end">Fuel Used</th>
                    <th class="text-end">Debris Hauled</th>
                    <th>Notes</th>

                    @if (User.IsInRole("Administrator"))
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>@log.LogDate</td>

                        <td>
                            <a asp-controller="WorkSites"
                               asp-action="Details"
                               asp-route-id="@log.WorkSiteId">
                                @log.WorkSiteName
                            </a>
                        </td>

                        <td>
                            <a asp-controller="HeavyMachines"
                               asp-action="Details"
                               asp-route-id="@log.HeavyMachineId">
                                @log.MachineName
                            </a>

                            <div class="small text-muted">
                                @log.MachineInventoryNumber
                            </div>
                        </td>

                        <td>@log.OperatorName</td>

                        <td class="text-end">
                            @log.HoursWorked.ToString("N1") hrs
                        </td>

                        <td class="text-end">
                            @log.FuelConsumedLiters.ToString("N1") L
                        </td>

                        <td class="text-end">
                            @log.DebrisHauledTons.ToString("N1") t
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(log.Notes)
                                ? "—"
                                : log.Notes)
                        </td>

                        @if (User.IsInRole("Administrator"))
                        {
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteLogModal-@log.Id">
                                    Delete
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        @foreach (var log in Model.Logs)
        {
            <div class="modal fade"
                 id="deleteLogModal-@log.Id"
                 tabindex="-1"
                 aria-labelledby="deleteLogLabel-@log.Id"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="deleteLogLabel-@log.Id">
                                Delete Work Log
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">
                            Are you sure you want to delete the work log from
                            <strong>@log.LogDate</strong> for
                            <strong>@log.MachineName</strong>?

                            <p class="text-muted small mt-2 mb-0">
                                This will subtract
                                @log.HoursWorked.ToString("N1") hours
                                from the machine's engine hours.
                            </p>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <form asp-action="Delete"
                                  asp-route-id="@log.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
            <p class="text-muted small mb-2">
                Showing page <strong>@Model.CurrentPage</strong>
                of <strong>@Model.TotalPages</strong>
                (@Model.TotalLogs total entries)
            </p>

            <nav aria-label="Work logs pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-workSiteId="@Model.WorkSiteId"
                           asp-route-heavyMachineId="@Model.HeavyMachineId"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-currentPage="@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-workSiteId="@Model.WorkSiteId"
                               asp-route-heavyMachineId="@Model.HeavyMachineId"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-currentPage="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-workSiteId="@Model.WorkSiteId"
                           asp-route-heavyMachineId="@Model.HeavyMachineId"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-currentPage="@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
