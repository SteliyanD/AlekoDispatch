
@using AlekoDispatch.ViewModels.DailyWorkLogs

@model IEnumerable<DailyWorkLogIndexViewModel>

@{
    ViewData["Title"] = "Daily Work Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Daily Work Logs</h1>
        <p class="text-muted mb-0">
            Records of machine usage, fuel consumption and daily work.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Log Daily Shift
    </a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">
        No work logs have been recorded yet.
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Work Site</th>
                    <th>Machine</th>
                    <th>Operator</th>
                    <th class="text-end">Hours Worked</th>
                    <th class="text-end">Fuel Used</th>
                    <th class="text-end">Debris Hauled</th>
                    <th>Notes</th>

                    @if (User.IsInRole("Administrator"))
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.LogDate</td>

                        <td>
                            <a asp-controller="WorkSites"
                               asp-action="Details"
                               asp-route-id="@log.WorkSiteId">
                                @log.WorkSiteName
                            </a>
                        </td>

                        <td>
                            <a asp-controller="HeavyMachines"
                               asp-action="Details"
                               asp-route-id="@log.HeavyMachineId">
                                @log.MachineName
                            </a>

                            <div class="small text-muted">
                                @log.MachineInventoryNumber
                            </div>
                        </td>

                        <td>@log.OperatorName</td>

                        <td class="text-end">
                            @log.HoursWorked.ToString("N1") hrs
                        </td>

                        <td class="text-end">
                            @log.FuelConsumedLiters.ToString("N1") L
                        </td>

                        <td class="text-end">
                            @log.DebrisHauledTons.ToString("N1") t
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(log.Notes)
                                ? "—"
                                : log.Notes)
                        </td>

                        @if (User.IsInRole("Administrator"))
                        {
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteLogModal-@log.Id">
                                    Delete
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        @foreach (var log in Model)
        {
            <div class="modal fade"
                 id="deleteLogModal-@log.Id"
                 tabindex="-1"
                 aria-labelledby="deleteLogLabel-@log.Id"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="deleteLogLabel-@log.Id">
                                Delete Work Log
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">
                            Are you sure you want to delete the work log from
                            <strong>@log.LogDate</strong> for
                            <strong>@log.MachineName</strong>?

                            <p class="text-muted small mt-2 mb-0">
                                This will subtract
                                @log.HoursWorked.ToString("N1") hours
                                from the machine's engine hours.
                            </p>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <form asp-action="Delete"
                                  asp-route-id="@log.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}
