
@using AlekoDispatch.ViewModels.DailyWorkLogs

@model DailyWorkLogFormModel

@{
    ViewData["Title"] = "Log Daily Shift";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Log Daily Work Shift</h1>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to Logs
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LogDate" class="form-label">
                                Date
                            </label>

                            <input asp-for="LogDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="LogDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OperatorName" class="form-label">
                                Operator Name
                            </label>

                            <input asp-for="OperatorName"
                                   class="form-control"
                                   placeholder="Enter operator name" />

                            <span asp-validation-for="OperatorName"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="WorkSiteId" class="form-label">
                                Work Site
                            </label>

                            <select asp-for="WorkSiteId"
                                    asp-items="Model.AvailableWorkSites"
                                    class="form-select">
                                <option value="">Select Work Site</option>
                            </select>

                            <span asp-validation-for="WorkSiteId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HeavyMachineId" class="form-label">
                                Heavy Machine
                            </label>

                            <select asp-for="HeavyMachineId"
                                    asp-items="Model.AvailableMachines"
                                    class="form-select">
                                <option value="">Select Machine</option>
                            </select>

                            <span asp-validation-for="HeavyMachineId"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="HoursWorked" class="form-label">
                                Hours Worked
                            </label>

                            <input asp-for="HoursWorked"
                                   type="number"
                                   step="0.5"
                                   class="form-control" />

                            <span asp-validation-for="HoursWorked"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FuelConsumedLiters" class="form-label">
                                Fuel Used (L)
                            </label>

                            <input asp-for="FuelConsumedLiters"
                                   type="number"
                                   step="0.1"
                                   class="form-control" />

                            <span asp-validation-for="FuelConsumedLiters"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DebrisHauledTons" class="form-label">
                                Debris Hauled (t)
                            </label>

                            <input asp-for="DebrisHauledTons"
                                   type="number"
                                   step="0.1"
                                   class="form-control" />

                            <span asp-validation-for="DebrisHauledTons"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Additional information about the shift">
                        </textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Submit Work Log
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
